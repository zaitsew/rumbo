# Copy this to .env. ./check.sh requires only RUMBO_OWNER_KEY; everything else is optional.

# The one key that gates the site, the API and MCP (D5). Generate one: openssl rand -hex 24
# Rotating it signs every browser out and changes the /mcp/<key> URL.
RUMBO_OWNER_KEY=

# SQLite file. Default ./data/rumbo.db. On the droplet the compose file sets /data/rumbo.db.
# RUMBO_DB=./data/rumbo.db

# Optional. A source whose key is missing stays off; the site works without any of them.
# ACCOUNTS_SERVICE_RUMBO=       # accounts hub token for the product "rumbo" (AI features)
# TRAVELPAYOUTS_TOKEN=          # cached fares
# TICKETMASTER_API_KEY=         # events
# VIATOR_API_KEY=               # activities
# TIQETS_API_KEY=               # activities
