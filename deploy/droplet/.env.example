# Rendered to /srv/rumbo/.env on the server (mode 600) the first time only.
# Fill RUMBO_OWNER_KEY, then: cd /srv && docker compose up -d rumbo
# Generate one with: openssl rand -hex 24
RUMBO_OWNER_KEY=

# Optional. A source whose key is missing stays off.
# ACCOUNTS_SERVICE_RUMBO=
# ACCOUNTS_URL=                # accounts hub host (https://<project>.supabase.co); required for the AI features, no default
# TRAVELPAYOUTS_TOKEN=
# TICKETMASTER_API_KEY=
# VIATOR_API_KEY=
# TIQETS_API_KEY=
