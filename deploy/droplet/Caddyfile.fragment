# One site block, rendered to /srv/rumbo/Caddyfile on the shared server, where the
# root /srv/Caddyfile picks it up with `import /srv/*/Caddyfile`. `common` is the
# shared snippet (compression, HSTS, nosniff, no Server header). Caddy gets the
# certificate itself as long as the hostname resolves to this box.

{{name}}.{{domain}} {
	import common

	# Hashed build output: the file name changes whenever the content does.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy {{name}}:{{port}}
}
